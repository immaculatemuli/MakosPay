{
  "name": "farepay-backend",
  "version": "0.2.0",
  "private": true,
  "description": "FarePay backend: matatu fare payments by QR code, passenger wallets and daily owner payouts",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "set-routes": "node --env-file-if-exists=.env scripts/set-routes.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "test": "node --test",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:copy-from-sqlite": "node --env-file-if-exists=.env scripts/copy-sqlite-to-postgres.js",
    "test:pg": "node --env-file-if-exists=.env --test \"pg-tests/**/*.js\"",
    "test:postgres": "node scripts/run-tests-on-postgres.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  }
}
