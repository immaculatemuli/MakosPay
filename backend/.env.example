# Copy to .env and adjust.
PORT=4000
NODE_ENV=development

# REQUIRED in production: a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Office web dashboard sign-in (HttpOnly cookie), in hours (1-24).
WEB_SESSION_HOURS=12

DB_PATH=./data/farepay.db

# Which database the app uses: sqlite (DB_PATH above) or postgres (DATABASE_URL below).
DB_ENGINE=sqlite

# PostgreSQL (being prepared; the app still uses DB_PATH above until the switch-over).
# postgres://<account>:<password>@<server>:<port>/<database>
DATABASE_URL=postgres://farepay:change-me@localhost:5432/farepay
# Used by `yarn test:pg` only. It is emptied by the tests, so its name must end in _test.
TEST_DATABASE_URL=postgres://farepay:change-me@localhost:5432/farepay_test

# The SACCO name passengers see on the home screen.
SACCO_NAME=Your SACCO

# Kenyan times (HH:MM): owners are paid daily, then the books are checked (office alerted if anything is out).
PAYOUT_DAILY_AT=21:00
MONEY_CHECK_DAILY_AT=23:00
# Owners are paid only the fares the car's driver has released ("Send to owner" in the driver's app; the conductor
# can't). false: every fare is paid out by the daily run or the office's "Pay now".
PAYOUTS_NEED_DRIVER=true

# ---- Map of the car coming to pick a passenger ----
# A Google Maps Platform key with only the "Map Tiles API" allowed (Google Cloud console -> Credentials). Restrict it to
# the Map Tiles API and to this server's web address. Empty: OpenStreetMap's map (fine for trying out, not for real use).
GOOGLE_MAPS_API_KEY=

# The phone app: newest version and oldest that still works (set after publishing a new APK). Empty: no check.
APP_LATEST_VERSION=
APP_MIN_VERSION=
# Where the "Download" button goes (default: the newest FarePay.apk on GitHub).
APP_DOWNLOAD_URL=
