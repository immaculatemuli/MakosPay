# FarePay server settings for the real server. Copy to /opt/farepay/backend/.env and fill in.
# Never share this file or put it in Git: it holds the keys to the money.
NODE_ENV=production
PORT=4000
# Caddy sits in front of FarePay on the same machine.
TRUST_PROXY=1

# Make each of these with:  openssl rand -hex 32
JWT_SECRET=
MPESA_CALLBACK_SECRET=

DB_PATH=./data/farepay.db
BACKUP_DIR=./data/backups
BACKUP_DAILY_AT=03:00
BACKUP_KEEP=14

SACCO_NAME=Your SACCO name

PAYOUT_DAILY_AT=21:00
MONEY_CHECK_DAILY_AT=23:00
MIN_TOPUP=10
MAX_TOPUP=20000
MAX_WALLET_BALANCE=50000
MIN_WITHDRAWAL=10
MAX_WITHDRAWALS_PER_DAY=2

# ---- Safaricom Daraja ----
# sandbox while testing; production only after Safaricom's Go Live approval (real money).
PAYMENT_PROVIDER=daraja
MPESA_MODE=sandbox
# Your server's https address (the same one as in the Caddyfile), no slash at the end.
MPESA_CALLBACK_BASE_URL=https://api.example.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Your Paybill number and its Lipa na M-Pesa Online passkey (from Safaricom after Go Live).
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline for a Paybill. (For a Till: CustomerBuyGoodsOnline, with MPESA_PARTY_B = the Till number.)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For sending money to owners and passengers (B2C/B2B): the shortcode, the API user (initiator) you
# created on the M-Pesa org portal, and its encrypted password (security credential).
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
